{
  "expo": {
    "name": "scan-barcode-app",
    "slug": "scan-barcode-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanbarcodeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cipherlab.scanbarcodeapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "แอพนี้ต้องการใช้กล้องเพื่อสแกนบาร์โค้ดและ QR Code",
        "NSMicrophoneUsageDescription": "แอพนี้ไม่ได้ใช้ไมโครโฟน แต่จำเป็นสำหรับการใช้กล้อง"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cipherlab.scanbarcodeapp",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "allowBackup": false,
      "hardwareAccelerated": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "56fb717d-362a-47d0-a22d-98020472fd45"
      }
    }
  }
}
