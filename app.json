{
  "expo": {
    "name": "SHIP2CU Scanner",
    "slug": "scan-barcode-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon/android-chrome-512x512.png",
    "scheme": "scanbarcodeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon/android-chrome-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cipherlab.scanbarcodeapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "แอพนี้ต้องการใช้กล้องเพื่อสแกนบาร์โค้ดและ QR Code",
        "NSMicrophoneUsageDescription": "แอพนี้ไม่ได้ใช้ไมโครโฟน แต่จำเป็นสำหรับการใช้กล้อง"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/android-chrome-512x512.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cipherlab.scanbarcodeapp",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a71ffd90-465e-4cd5-a189-68547ef30743"
      }
    }
  }
}
